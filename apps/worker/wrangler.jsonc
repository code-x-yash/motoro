{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motoro-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../web/out",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "dev": {
    "port": 8787
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3005,https://motoro-web.vercel.app",
    "ENABLE_SEED_ROUTES": "true",
    "PAYMENT_PROVIDER": "test",
    "SESSION_COOKIE_NAME": "rr_session",
    "SESSION_SECRET": "dev-only-session-secret-not-for-production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motoro",
      "database_id": "cb1f283d-9b21-46ea-95af-196003e010a9",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1354c017974e455fa8607ad029064449"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "motoro-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASKS",
        "queue": "motoro-tasks"
      },
      {
        "binding": "TASKS_DLQ",
        "queue": "motoro-tasks-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "motoro-tasks",
        "max_retries": 3,
        "dead_letter_queue": "motoro-tasks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EMERGENCY_ROOM",
        "class_name": "EmergencyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EmergencyRoom"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "motoro-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ENABLE_SEED_ROUTES": "false",
        "ALLOWED_ORIGINS": "https://staging.motoro.example,http://localhost:3000",
        "PAYMENT_PROVIDER": "test",
        "SESSION_COOKIE_NAME": "rr_session",
        // Never commit a real secret here — set it per environment:
        //   npx wrangler secret put SESSION_SECRET --env staging
        "SESSION_SECRET": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motoro",
          "database_id": "cb1f283d-9b21-46ea-95af-196003e010a9",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "1354c017974e455fa8607ad029064449"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "motoro-files"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "TASKS",
            "queue": "motoro-tasks"
          },
          {
            "binding": "TASKS_DLQ",
            "queue": "motoro-tasks-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "motoro-tasks",
            "max_retries": 3,
            "dead_letter_queue": "motoro-tasks-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EMERGENCY_ROOM",
            "class_name": "EmergencyRoom"
          }
        ]
      }
    },
    "production": {
      "name": "motoro-api",
      "vars": {
        "ENVIRONMENT": "production",
        "ENABLE_SEED_ROUTES": "false",
        "ALLOWED_ORIGINS": "https://motoro-api.motoro.workers.dev",
        "PAYMENT_PROVIDER": "razorpay",
        "SESSION_COOKIE_NAME": "rr_session",
        // Set per environment: npx wrangler secret put SESSION_SECRET
        "SESSION_SECRET": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motoro",
          "database_id": "cb1f283d-9b21-46ea-95af-196003e010a9",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "1354c017974e455fa8607ad029064449"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "motoro-files"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "TASKS",
            "queue": "motoro-tasks"
          },
          {
            "binding": "TASKS_DLQ",
            "queue": "motoro-tasks-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "motoro-tasks",
            "max_retries": 3,
            "dead_letter_queue": "motoro-tasks-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EMERGENCY_ROOM",
            "class_name": "EmergencyRoom"
          }
        ]
      }
    }
  }
}
