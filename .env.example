# ---------------------------------------------------------------------------
# Motoro environment variables
# Copy to .env / .env.local and fill in real values. NEVER commit real secrets.
# .env* files are gitignored (except this example).
# ---------------------------------------------------------------------------

# --- Cloudflare (server-side only, used by wrangler + scripts) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- R2 (private object storage) ---
R2_BUCKET_NAME=motoro-files
# Optional: enables browser-direct presigned S3 URLs. When unset, uploads are
# relayed through the Worker (still private, still signed).
# If you set these, also set SESSION_SECRET (used to sign object URLs).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Sessions / security ---
# Generate with: openssl rand -hex 32
# Deploy with:   npx wrangler secret put SESSION_SECRET [--env staging|production]
SESSION_SECRET=change-me-to-a-long-random-string
# Cookie name (must match wrangler.jsonc vars for that environment).
SESSION_COOKIE_NAME=rr_session
# Which worker environment this config targets: development | staging | production
ENVIRONMENT=development
# Comma separated list of allowed browser origins (CORS + CSRF origin checks).
# Production value: https://motoro-api.motoro.workers.dev
ALLOWED_ORIGINS=http://localhost:3000

# --- Web app ---
# Backend origin used by the Next.js /api/* rewrite (next.config.js).
# Dev default: http://127.0.0.1:8787 (wrangler dev).
# Single-worker production: same origin as the site, e.g.
#   API_BASE_URL=https://motoro-api.motoro.workers.dev
API_BASE_URL=http://127.0.0.1:8787

# --- Geocoding (optional) ---
# Default provider is nominatim/OSM (no key required). Set GEOCODER_PROVIDER=none
# to disable geocoding entirely.
GEOCODER_PROVIDER=
GEOCODER_KEY=

# --- Payments (optional) ---
# provider: "test" (sandbox, development only) | "razorpay" | "stripe"
PAYMENT_PROVIDER=test
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
# Razorpay webhook secret (x-razorpay-signature verification).
PAYMENT_WEBHOOK_SECRET=

# --- Notification providers (optional; in-app always works) ---
# Email via Resend (default) or Postmark. EMAIL_FROM e.g. "Motoro <hi@yourdomain.com>"
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
EMAIL_FROM=
# SMS via Twilio: SMS_PROVIDER_KEY="ACCOUNT_SID:AUTH_TOKEN", SMS_FROM="+15005550006"
SMS_PROVIDER_KEY=
SMS_FROM=
# WhatsApp via Meta Graph API: token + phone number id
WHATSAPP_PROVIDER_KEY=
WHATSAPP_PHONE_ID=

# --- Web Push (VAPID) ---
# Generate a key pair with: npx web-push generate-vapid-keys
# When unset, development uses ephemeral keys cached in KV.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Feature flags ---
# Set to "true" to expose /api/dev/* helpers (seed, demo automation).
# Never "true" in production (wrangler enforces ENVIRONMENT too).
ENABLE_SEED_ROUTES=true
